---
/**
 * Owns id="contact". The form itself is Phase 6; what ships today is the copy, the
 * socials and the plain mailto — which is the ONLY working contact path in v1, since
 * the form is a documented stub (decision #4).
 */
import type { Lang } from '~/i18n/routes.ts';
import { SITE } from '~/lib/site.ts';
import { useTranslations } from '~/i18n/utils.ts';
// import ContactForm from '~/components/form/ContactForm.astro'; // restore with the form
import Reveal from '~/components/motion/Reveal.astro';
import Section from '~/components/ui/Section.astro';
import Container from '~/components/ui/Container.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import InstagramIcon from '~/components/ui/icons/InstagramIcon.astro';
import MailIcon from '~/components/ui/icons/MailIcon.astro';

interface Props {
  lang: Lang;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);
---

<Section background="coal" id="contact">
  <Container>
    <div class="grid gap-12 lg:grid-cols-[1fr_0.7fr] lg:gap-20">
      <div>
        <Reveal>
          <SectionHeading
            eyebrow={t.contact.eyebrow}
            heading={t.contact.heading}
            lead={t.contact.lead}
          />
        </Reveal>
        {
          /*
          HIDDEN, NOT REMOVED — to be switched on with the backend.

          The form is built and tested: validation, states, focus management, honeypot
          and i18n are all production-ready (specs/05-pages-and-sections.md § Contact
          form). What it lacks is delivery — submitContact is a documented stub — and a
          form that says "Te responderé lo antes posible" while sending nothing is
          worse than no form at all.

          To restore it: uncomment the block below and the import above, then implement
          submitContact in src/lib/contact.ts. Nothing else needs to change.
        */
        }
        {
          /*
        <div class="mt-10">
          <ContactForm {lang} />
        </div>
        */
        }
      </div>

      <Reveal as="aside" delay={120} class="lg:pt-4">
        <h3 class="text-eyebrow text-mustang uppercase">{t.contact.socials.heading}</h3>
        <ul class="mt-4 flex flex-col gap-2">
          {
            SITE.socials
              .filter((social) => social.icon !== 'mail')
              .map((social) => (
                <li>
                  <a
                    href={social.href}
                    class="text-body text-mist hover:text-bone inline-flex min-h-11 items-center gap-3 transition-colors"
                    {...(social.icon === 'instagram'
                      ? { rel: 'me noopener', target: '_blank' }
                      : {})}
                  >
                    {social.icon === 'instagram' ? (
                      <InstagramIcon class="size-5" />
                    ) : (
                      <MailIcon class="size-5" />
                    )}
                    {t.contact.socials[social.id]}
                  </a>
                </li>
              ))
          }
        </ul>

        <p class="text-body text-mist border-iron mt-8 border-t pt-6">
          {t.contact.directEmail}{' '}
          <a href={`mailto:${SITE.email}`} class="link-underline text-bone">
            {SITE.email}
          </a>
        </p>
      </Reveal>
    </div>
  </Container>
</Section>
