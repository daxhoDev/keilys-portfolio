---
/**
 * The six featured photographs. Receives them rather than querying, so the page owns
 * the data and this component stays a layout.
 *
 * A fixed three-column grid rather than the masonry: these six are chosen, so their
 * arrangement is deliberate. The cards are the same PhotoCard the gallery uses and sit
 * in a [data-gallery], so the one lightbox controller serves both pages.
 */
import type { Lang } from '~/i18n/routes.ts';
import { path } from '~/i18n/routes.ts';
import { useTranslations } from '~/i18n/utils.ts';
import type { Photo } from '~/lib/photos.ts';
import { FEATURED_COUNT } from '~/lib/photos.ts';
import PhotoCard from '~/components/gallery/PhotoCard.astro';
import Lightbox from '~/components/gallery/Lightbox.astro';
import Section from '~/components/ui/Section.astro';
import Container from '~/components/ui/Container.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import Button from '~/components/ui/Button.astro';

interface Props {
  lang: Lang;
  photos: Photo[];
}

const { lang, photos }: Props = Astro.props;
const t = useTranslations(lang);

if (photos.length !== FEATURED_COUNT) {
  throw new Error(
    `FeaturedWork expects exactly ${FEATURED_COUNT} photographs, received ${photos.length}.`,
  );
}
---

<Section background="ink">
  <Container>
    <SectionHeading eyebrow={t.work.eyebrow} heading={t.work.heading} lead={t.work.lead} />

    <ul data-gallery class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        photos.map((photo, index) => (
          <PhotoCard
            {photo}
            {lang}
            {index}
            interaction="lightbox"
            loading={index < 3 ? 'eager' : 'lazy'}
            class="mb-0"
          />
        ))
      }
    </ul>

    <div class="mt-12">
      <Button href={path('work', lang)} variant="primary">{t.work.cta}</Button>
    </div>

    <Lightbox {lang} />
  </Container>
</Section>
