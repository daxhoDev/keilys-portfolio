---
/**
 * Filter chip.
 *
 * The active styling is driven by `aria-pressed`, not by a server-rendered class.
 * Those two can drift: the first version painted the active chip at build time while
 * the script only flipped the attribute, so the row stayed stuck on "all" no matter
 * what was pressed. Binding the paint to the attribute makes that impossible — the
 * thing a screen reader reads and the thing an eye sees are now the same state.
 *
 * A chip with a zero count renders disabled rather than hidden: a filter row that
 * changes shape depending on the content reads as a bug, and hiding it would silently
 * drop the fact that a whole tone is missing.
 */
interface Props {
  label: string;
  count?: number;
  active: boolean;
  value: string;
  class?: string;
}

const { label, count, active, value, class: className }: Props = Astro.props;
const disabled = count === 0;
---

<button
  type="button"
  data-filter={value}
  aria-pressed={active ? 'true' : 'false'}
  {disabled}
  class:list={[
    'text-label duration-base inline-flex min-h-11 items-center gap-2 rounded-sm border px-4 py-2 whitespace-nowrap transition-colors',
    'border-iron text-mist hover:border-steel hover:text-bone',
    'aria-pressed:border-mustang aria-pressed:bg-mustang aria-pressed:text-ink aria-pressed:hover:border-mustang aria-pressed:hover:text-ink',
    disabled && 'hover:border-iron hover:text-mist cursor-not-allowed opacity-40',
    className,
  ]}
>
  {label}
  {count !== undefined && <span class="text-body-sm tabular-nums opacity-70">{count}</span>}
</button>
