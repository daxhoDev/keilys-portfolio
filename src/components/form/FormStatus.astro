---
/**
 * The success panel and the error alert. Both live in the DOM from the start and are
 * toggled with `hidden`, so focus management is a focus() call rather than a race
 * against an element that may not exist yet.
 */
import type { Lang } from '~/i18n/routes.ts';
import { useTranslations } from '~/i18n/utils.ts';
import Button from '~/components/ui/Button.astro';

interface Props {
  lang: Lang;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);
---

{/* Success replaces the form entirely. role="status" so it is announced politely. */}
<div
  data-form-success
  hidden
  role="status"
  class="border-iron bg-graphite flex flex-col items-start gap-4 rounded-sm border p-8"
>
  <svg
    viewBox="0 0 24 24"
    class="text-success size-8"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="9"></circle>
    <path d="m8 12.5 2.5 2.5L16 9.5" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>

  <h3 data-form-success-heading tabindex="-1" class="font-display text-display-sm text-bone">
    {t.contact.form.success.heading}
  </h3>
  <p class="text-body text-mist measure">{t.contact.form.success.body}</p>

  <Button variant="ghost" data-form-reset>{t.contact.form.success.again}</Button>
</div>

{/* The error alert sits above the submit button and keeps every value the user typed. */}
<div
  data-form-error
  hidden
  role="alert"
  tabindex="-1"
  class="border-danger bg-graphite flex flex-col gap-2 rounded-sm border p-5"
>
  <p class="text-label text-danger">{t.contact.form.error.heading}</p>
  <p class="text-body-sm text-mist">{t.contact.form.error.body}</p>
</div>
