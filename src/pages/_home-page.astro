---
/**
 * The landing page, shared by / (Spanish) and /en (English).
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import type { Lang } from '~/i18n/routes.ts';
import { useTranslations } from '~/i18n/utils.ts';
import { getFeaturedPhotos } from '~/lib/photos.ts';
import Hero from '~/components/sections/Hero.astro';
import AboutPreview from '~/components/sections/AboutPreview.astro';
import FeaturedWork from '~/components/sections/FeaturedWork.astro';
import ContactSection from '~/components/sections/ContactSection.astro';

interface Props {
  lang: Lang;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);

const featured = await getFeaturedPhotos();
---

<BaseLayout
  {lang}
  title={t.meta.home.title}
  description={t.meta.home.description}
  imageAlt={t.hero.imageAlt}
  transparentHeader
>
  <Hero {lang} />
  <AboutPreview {lang} />
  <FeaturedWork {lang} photos={featured} />
  <ContactSection {lang} />
</BaseLayout>
