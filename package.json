{
  "name": "keily-portfolio",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "placeholders": "node scripts/generate-placeholders.mjs",
    "astro": "astro",
    "test": "npm run build && node --test tests/*.test.ts && playwright test",
    "test:unit": "node --test tests/routes.test.ts tests/dictionary.test.ts tests/images.test.ts",
    "test:build": "node --test tests/build-output.test.ts",
    "test:browser": "playwright test",
    "check:hero": "node scripts/check-hero-contrast.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sharp": "^0.33.5",
    "typescript": "^5.6.0"
  }
}
